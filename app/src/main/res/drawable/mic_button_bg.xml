<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#FF3B66E4"
                android:endColor="#FF2740A4"
                android:angle="270" />
            <corners android:radius="32dp" />
            <stroke android:width="1dp" android:color="@color/accent_gold" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#FF3151C2"
                android:endColor="#FF253782"
                android:angle="270" />
            <corners android:radius="32dp" />
            <stroke android:width="1dp" android:color="@color/accent_gold" />
        </shape>
    </item>
</selector>
