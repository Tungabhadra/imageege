<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".ImageResultActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_nav"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="80dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="Your Image"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline4"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Image preview without container -->
            <ImageView
                android:id="@+id/result_image"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginBottom="32dp"
                android:adjustViewBounds="true"
                android:contentDescription="Processed image"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_to_project_button"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Save to Project"
                android:textColor="@color/pure_white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_projects"
                app:iconGravity="textStart"
                app:iconPadding="16dp"
                app:iconSize="28dp"
                app:iconTint="@color/pure_white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/send_to_marketplace_button"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_button"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Send to Marketplace"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:icon="@drawable/ic_marketplace"
                app:iconGravity="textStart"
                app:iconPadding="16dp"
                app:iconSize="28dp"
                app:iconTint="@color/text_primary" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/glass_toolbar"
        app:itemIconTint="@color/text_primary"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
